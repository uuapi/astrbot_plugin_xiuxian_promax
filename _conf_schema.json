  "TRIBULATION_CONFIG": {
    "description": "⚡ 天劫系统",
    "type": "object",
    "items": {
      "MAJOR_REALM_BOUNDARIES": {
        "description": "触发天劫的境界节点",
        "type": "list",
        "default": [12, 18, 24, 30, 36, 42, 48],
        "hint": "突破到这些 level_index 时触发天劫（对应金丹→元婴等重大境界）。",
        "implicit": false
      },
      "BASE_SURVIVE_RATE": { "description": "基础存活率", "type": "float", "default": 0.55, "hint": "每道天雷的基础存活概率。" },
      "TALISMAN_BONUS": { "description": "护体符加成", "type": "float", "default": 0.15, "hint": "每张护体符提升的存活概率（自动消耗，最多2张）。" },
      "TRIBULATION_BONUS_PCT": { "description": "天劫淬体奖励", "type": "float", "default": 0.05, "hint": "全属性提升百分比（0.05=5%）。" },
      "TRIB_FAIL_EXP_LOSS": { "description": "天劫失败修为损失", "type": "float", "default": 0.20, "hint": "修为损失百分比（0.20=20%）。" }
    }
  },
