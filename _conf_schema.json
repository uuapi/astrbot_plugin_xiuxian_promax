{
  "IMAGE_CARDS": {
    "description": "🖼️ 图片卡片设置",
    "type": "object",
    "items": {
      "ENABLED": {
        "description": "总开关",
        "type": "bool",
        "default": true,
        "hint": "关闭后所有界面只发文本，不再生成磨砂玻璃图片卡片。"
      },
      "CARD_INFO": { "description": "我的信息卡片", "type": "bool", "default": true, "hint": "/我的信息 追加图片卡片。" },
      "CARD_CHECKIN": { "description": "签到卡片", "type": "bool", "default": true, "hint": "/签到 追加图片卡片。" },
      "CARD_BAG": { "description": "储物戒卡片", "type": "bool", "default": true, "hint": "/储物戒 追加图片卡片。" },
      "CARD_PET": { "description": "灵兽卡片", "type": "bool", "default": true, "hint": "/我的灵兽 追加图片卡片。" },
      "CARD_BOSS": { "description": "世界Boss卡片", "type": "bool", "default": true, "hint": "/世界Boss状态 追加图片卡片。" },
      "CARD_FARM": { "description": "灵田卡片", "type": "bool", "default": true, "hint": "/我的灵田 追加图片卡片。" },
      "CARD_SHOP": { "description": "商店货架卡片", "type": "bool", "default": true, "hint": "/丹阁 /器阁 /百宝阁 追加图片卡片。" },
      "CARD_MARKET": { "description": "坊市列表卡片", "type": "bool", "default": true, "hint": "/坊市 追加图片卡片。" },
      "CARD_EQUIP": { "description": "我的装备卡片", "type": "bool", "default": true, "hint": "/我的装备 追加图片卡片。" }
    }
  },
  "ACCESS_CONTROL": {
    "description": "🔐 访问控制",
    "type": "object",
    "items": {
      "WHITELIST_GROUPS": {
        "description": "白名单群号列表",
        "type": "list",
        "default": [],
        "hint": "允许使用此插件的QQ群号。留空则所有群聊可用。"
      },
      "SHOP_MANAGERS": {
        "description": "商店管理员名单",
        "type": "list",
        "default": [],
        "hint": "可手动刷新商店的用户ID。为空则不允许手动刷新。"
      },
      "BOSS_ADMINS": {
        "description": "Boss管理员名单",
        "type": "list",
        "default": [],
        "hint": "可手动生成Boss/开启活动/发布公告的用户ID。"
      }
    }
  },
  "VALUES": {
    "description": "⚙️ 核心数值",
    "type": "object",
    "items": {
      "INITIAL_GOLD": { "description": "初始灵石", "type": "int", "default": 100, "hint": "新角色初始灵石。" },
      "BASE_EXP_PER_MINUTE": { "description": "闭关基础修为/分钟", "type": "int", "default": 100, "hint": "受灵根/品阶/丹药等多重倍率影响。" },
      "CHECK_IN_GOLD_MIN": { "description": "签到灵石最小", "type": "int", "default": 100, "hint": "" },
      "CHECK_IN_GOLD_MAX": { "description": "签到灵石最大", "type": "int", "default": 800, "hint": "" },
      "BREAKTHROUGH_DEATH_PROBABILITY": { "description": "突破失败死亡概率范围", "type": "list", "default": [0.01, 0.1], "hint": "[最小,最大]，重大境界走天劫不走此概率。" },
      "PAVILION_REFRESH_HOURS": { "description": "商店刷新间隔(小时)", "type": "int", "default": 1, "hint": "0=不自动刷新。" },
      "BANK_DAILY_INTEREST_RATE": { "description": "存款日利率", "type": "float", "default": 0.002, "hint": "0.002=0.2%。" },
      "BANK_LOAN_INTEREST_RATE": { "description": "贷款日利率", "type": "float", "default": 0.005, "hint": "" },
      "BANK_MAX_DEPOSIT": { "description": "存款上限", "type": "int", "default": 10000000, "hint": "" },
      "BANK_MAX_LOAN_AMOUNT": { "description": "贷款上限", "type": "int", "default": 1000000, "hint": "" }
    }
  },
  "TOWER_CONFIG": {
    "description": "🗼 镇妖塔",
    "type": "object",
    "items": {
      "DAILY_CHALLENGES": { "description": "每日挑战次数", "type": "int", "default": 3, "hint": "" },
